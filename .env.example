# Kopiere diese Datei nach .env (wird nicht eingecheckt) und fülle die Werte aus.
# Ohne Angaben läuft die App im Entwicklungsmodus mit Testzahlung und Mails in der Konsole.

NODE_ENV=production
PORT=3000
APP_URL=https://deine-domain.de
SCHOOL_NAME=Fundament
# Mindestens 32 zufällige Zeichen, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Hinter einem Reverse-Proxy (nginx, Caddy, Render …): Anzahl der Proxys
TRUST_PROXY=1
DATA_DIR=/var/lib/schule

PRICE_LABEL=39
PRICE_NOTE=pro Monat, monatlich kündbar
# Monatspreis des Telegram-Kreises (Zusatz zur Mitgliedschaft)
TELEGRAM_PRICE_LABEL=9

# Zahlung (Stripe, Abo-Preis im Stripe-Dashboard anlegen)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Zweiter Abo-Preis für den Telegram-Kreis (optional; ohne ihn wird der Zusatz nicht angeboten)
STRIPE_TELEGRAM_PRICE_ID=price_...

# E-Mail-Versand
SMTP_URL=smtps://benutzer:passwort@smtp.anbieter.de:465
MAIL_FROM=Fundament <hallo@deine-domain.de>

# Telegram (optional): Bot als Admin in Gruppe und Kanal
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# Maximale Videogröße beim Upload in MB
MAX_VIDEO_MB=2048
