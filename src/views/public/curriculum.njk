{% extends "layout/base.njk" %}
{% block main %}
<section class="page-head">
  <div class="wrap">
    <p class="muted">Lehrplan · {{ main.title }}</p>
    <h1 class="mega" data-reveal>{{ main.level_title }}</h1>
    <p class="lead">{{ total }} Seminare, aufgeteilt in {{ blocks.length }} Abschnitte. Jedes Seminar endet mit einer Aufgabe. Das nächste öffnet sich erst, wenn du sie abgegeben hast.</p>
  </div>
</section>
<section class="section">
  <div class="wrap">
    {% include "partials/curriculum-grid.njk" %}
    <p class="actions"><a class="btn" href="/registrieren">Kostenlos starten</a> <a class="btn btn-ghost" href="/faecher">Alle Lehrgänge</a></p>
  </div>
</section>
{% endblock %}
