{% extends "layout/base.njk" %}
{% from "partials/macros.njk" import csrf with context %}
{% from "partials/icons.njk" import icon %}
{% block main %}
<section class="page-head subject-head">
  <div class="wrap">
    <span class="subject-icon subject-icon-lg" data-reveal>{{ icon(subject.slug) }}</span>
    <h1 class="mega" data-reveal>{{ subject.title }}</h1>
    <p class="lead" data-reveal>{{ subject.tagline }}</p>
    {% if subject.status != 'live' %}<p class="pill" data-reveal>Startet bald</p>{% endif %}
  </div>
</section>
<section class="section">
  <div class="wrap two-col">
    <div>
      <p class="prose-lead" data-reveal>{{ subject.description }}</p>
      <h2 class="h3">{{ subject.level_title or 'Lehrplan' }}</h2>
      <div class="syllabus">
        {% for s in curriculum %}
          {% if loop.first or s.block_title != curriculum[loop.index0 - 1].block_title %}<p class="syllabus-block">{{ s.block_title }}</p>{% endif %}
          <div class="syllabus-row" data-reveal>
            <span class="syllabus-ico">{{ icon('play') }}</span>
            <span><strong>{{ s.title }}</strong>{% if s.summary %}<br><span class="muted small">{{ s.summary }}</span>{% endif %}</span>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="sticky-col">
      <article class="teacher teacher-stack cut" data-reveal>
        <div class="teacher-photo" aria-hidden="true"><span>{{ subject.teacher_name | initial }}</span></div>
        <div>
          <p class="muted small">Dein Lehrer</p>
          <h2 class="h3">{{ subject.teacher_name }}</h2>
          <p>{{ subject.teacher_bio }}</p>
        </div>
      </article>
      {% if subject.status == 'live' %}
        {% include "partials/join-card.njk" %}
      {% else %}
        <form class="panel cut" method="post" action="/warteliste">
          {{ csrf() }}
          <input type="hidden" name="fach" value="{{ subject.slug }}">
          <h2 class="h3">Sei als Erster dabei</h2>
          <p>Wir sagen dir Bescheid, sobald {{ subject.title }} startet. Eine Mail, kein Newsletter.</p>
          <label>E-Mail-Adresse<input type="email" name="email" autocomplete="email" required maxlength="254"></label>
          <label class="check"><input type="checkbox" name="consent" required> <span>Ich möchte per E-Mail über den Start informiert werden. Die Einwilligung kann ich jederzeit widerrufen (<a href="/datenschutz">Datenschutz</a>).</span></label>
          <button class="btn" type="submit">Eintragen</button>
        </form>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
