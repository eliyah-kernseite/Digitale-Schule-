{% extends "layout/base.njk" %}
{% block main %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Fächer</p>
    <h1 class="h1">Drei Fächer. Ein Ziel.</h1>
    <p class="lead">Jedes Fach hat einen eigenen Lehrer, einen festen Lehrplan und Aufgaben, die dich wirklich weiterbringen. Mit der Mitgliedschaft bekommst du alle Fächer, sobald sie starten.</p>
  </div>
</section>
<section class="section">
  <div class="wrap cards cards-3">
    {% for s in subjects %}
    <article class="card cut {% if s.status == 'live' %}card-live{% endif %}">
      <p class="chip {% if s.status == 'live' %}chip-live{% endif %}">{{ 'Jetzt verfügbar' if s.status == 'live' else 'Bald verfügbar' }}</p>
      <h2 class="h3">{{ s.title }}</h2>
      <p>{{ s.description }}</p>
      <a class="link-arrow" href="/faecher/{{ s.slug }}">{{ 'Lehrplan und Lehrer' if s.status == 'live' else 'Auf die Warteliste' }}</a>
    </article>
    {% endfor %}
  </div>
</section>
{% endblock %}
