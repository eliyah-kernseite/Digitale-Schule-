{% extends "layout/base.njk" %}
{% from "partials/icons.njk" import icon %}
{% block main %}
<section class="page-head">
  <div class="wrap">
    <h1 class="mega" data-reveal>Wähle, woran du arbeitest.</h1>
    <p class="lead" data-reveal>{{ liveCount }} Lehrgänge sind live, weitere kommen dazu. Mit einer Mitgliedschaft bekommst du alle, auch die, die erst noch starten.</p>
  </div>
</section>
<section class="section">
  <div class="wrap subject-grid subject-grid-wide">
    {% for s in subjects %}
    <a class="subject-card {% if s.status != 'live' %}is-soon{% endif %}" href="/faecher/{{ s.slug }}" data-reveal data-glow>
      <span class="subject-icon">{{ icon(s.slug) }}</span>
      <span class="subject-meta">{% if s.status == 'live' %}{{ s.count }} Seminare · {{ s.level_title }}{% else %}Bald verfügbar{% endif %}</span>
      <h2 class="h3">{{ s.title }}</h2>
      <p>{{ s.description }}</p>
      <span class="subject-go">{{ 'Lehrplan ansehen' if s.status == 'live' else 'Auf die Warteliste' }} {{ icon('arrow') }}</span>
    </a>
    {% endfor %}
  </div>
</section>
<section class="final-cta">
  <div class="wrap">
    <p class="mega final-line" data-reveal>Ein Konto. Alle Lehrgänge im Blick.</p>
    <div class="actions" data-reveal><a class="btn btn-dark btn-big" href="/registrieren">Kostenlos starten {{ icon('arrow') }}</a></div>
  </div>
</section>
{% endblock %}
