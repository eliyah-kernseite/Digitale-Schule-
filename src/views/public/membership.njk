{% extends "layout/base.njk" %}
{% from "partials/macros.njk" import csrf, errors as showErrors with context %}
{% block main %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Mitgliedschaft</p>
    <h1 class="h1">Ein Abo. Alle Fächer.</h1>
    <p class="lead">Du bekommst sofort Zugang zur Grundstufe, deinem Zeugnis und der Community. Neue Fächer kommen ohne Aufpreis dazu.</p>
  </div>
</section>
<section class="section">
  <div class="wrap two-col">
    <div>
      {% include "partials/membership-card.njk" %}
      <ul class="facts">
        <li><strong>Monatlich kündbar.</strong> Mit einem Klick im Konto oder über „Verträge hier kündigen“.</li>
        <li><strong>Sichere Zahlung.</strong> Abgewickelt über unseren Zahlungsanbieter. Deine Kartendaten erreichen uns nie.</li>
        <li><strong>Keine versteckten Kosten.</strong> Der Preis ist der Preis.</li>
      </ul>
    </div>
    <div class="panel cut" id="bestellen">
      {% if aborted %}<p class="notice notice-warn">Die Zahlung wurde abgebrochen. Es wurde nichts berechnet.</p>{% endif %}
      {{ showErrors(errors) }}
      {% if not user %}
        <h2 class="h3">So wirst du Mitglied</h2>
        <ol class="mini-steps">
          <li>Konto anlegen und E-Mail bestätigen</li>
          <li>Hier einloggen und bestellen</li>
          <li>Direkt mit Seminar 1 starten</li>
        </ol>
        <p class="actions"><a class="btn" href="/registrieren">Konto erstellen</a> <a class="btn btn-ghost" href="/login?next=/mitgliedschaft">Ich habe schon ein Konto</a></p>
      {% elif hasAccess %}
        <h2 class="h3">Du bist schon Mitglied.</h2>
        <p>Deine Mitgliedschaft ist aktiv{% if sub and sub.current_period_end %} bis mindestens {{ sub.current_period_end | date }}{% endif %}.</p>
        <a class="btn" href="/app">Zu deiner Übersicht</a>
      {% elif not user.emailVerified %}
        <h2 class="h3">Bitte bestätige zuerst deine E-Mail.</h2>
        <p>Den Link findest du in deinem Postfach. Danach kannst du hier bestellen.</p>
      {% else %}
        <h2 class="h3">Bestellübersicht</h2>
        <dl class="summary">
          <div><dt>Produkt</dt><dd>Mitgliedschaft {{ schoolName }}</dd></div>
          <div><dt>Preis</dt><dd>{{ priceLabel }} € {{ priceNote }}</dd></div>
          <div><dt>Konto</dt><dd>{{ user.email }}</dd></div>
        </dl>
        <form method="post" action="/mitgliedschaft/checkout" class="stack">
          {{ csrf() }}
          <label class="check"><input type="checkbox" name="agb" required> <span>Ich habe die <a href="/agb" target="_blank" rel="noopener">AGB</a> und die <a href="/widerruf" target="_blank" rel="noopener">Widerrufsbelehrung</a> gelesen.</span></label>
          <label class="check"><input type="checkbox" name="waiver" required> <span>Ich verlange ausdrücklich, dass ihr vor Ablauf der Widerrufsfrist mit der Leistung beginnt. Mir ist bekannt, dass mein Widerrufsrecht damit erlischt.</span></label>
          <button class="btn btn-block" type="submit">Zahlungspflichtig bestellen</button>
          <p class="small muted">{% if paymentMock %}Testmodus: Es wird kein echtes Geld abgebucht.{% else %}Im nächsten Schritt gibst du deine Zahlungsdaten beim Zahlungsanbieter Stripe ein.{% endif %}</p>
        </form>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
