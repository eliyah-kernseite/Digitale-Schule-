{% extends "layout/app.njk" %}
{% from "partials/macros.njk" import progress, stars with context %}
{% block app %}
<header class="app-head">
  <h1 class="h1">Seminare</h1>
  <p class="muted">In fester Reihenfolge. Das nächste Seminar öffnet sich, sobald du die Aufgabe abgegeben hast.</p>
</header>
{% for c in courses %}
<section class="course">
  <h2 class="h3">{{ c.subject.title }} <span class="muted small">· {{ c.subject.level_title }}</span></h2>
  {{ progress(c.done, c.total, 'Abgeschlossen') }}
  {% for b in c.blocks %}
  <h3 class="block-title">{{ b.title }}</h3>
  <ol class="seminar-list">
    {% for s in b.items %}
    <li class="seminar-item is-{{ s.state }}">
      <span class="seminar-num">{{ s.number | pad2 }}</span>
      <div class="seminar-info">
        {% if s.state == 'locked' %}
          <strong>{{ s.title }}</strong>
          <span class="small muted">Gesperrt · öffnet nach Seminar {{ s.number - 1 }}</span>
        {% else %}
          <a href="/app/seminare/{{ s.id }}"><strong>{{ s.title }}</strong></a>
          <span class="small muted">
            {{ s.video_duration | duration }} Min.
            {% if s.state == 'done' %} · erledigt{% if s.avg_rating %} · Ø {{ s.avg_rating }} ★{% endif %}{% elif s.videoDone %} · Aufgabe offen{% elif s.watchedPercent %} · {{ s.watchedPercent }} % angesehen{% endif %}
          </span>
        {% endif %}
      </div>
      <span class="seminar-state" aria-hidden="true">{% if s.state == 'done' %}✓{% elif s.state == 'open' %}→{% else %}<svg viewBox="0 0 16 16" width="14" height="14"><path d="M4 7V5a4 4 0 0 1 8 0v2h1v8H3V7zm2 0h4V5a2 2 0 0 0-4 0z" fill="currentColor"/></svg>{% endif %}</span>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="muted">Die Seminare werden gerade vorbereitet.</p>
  {% endfor %}
</section>
{% endfor %}
{% if soon.length %}
<section class="course">
  <h2 class="h3">Bald verfügbar</h2>
  <div class="cards cards-2">
    {% for s in soon %}
    <article class="card cut"><p class="chip">Bald</p><h3 class="h4">{{ s.title }}</h3><p>{{ s.tagline }}</p><p class="small muted">Als Mitglied bekommst du das Fach automatisch, sobald es startet.</p></article>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
