{% extends "layout/app.njk" %}
{% from "partials/macros.njk" import csrf, errors as showErrors with context %}
{% block app %}
<header class="app-head">
  <h1 class="h1">Konto &amp; Abo</h1>
</header>

<section class="panel cut" id="abo">
  <h2 class="h3">Mitgliedschaft</h2>
  {% if user.isAdmin %}
    <p>Als Admin hast du vollen Zugang ohne Abo.</p>
  {% elif user.compAccessUntil and access and not (sub and sub.status in ['active', 'trialing', 'past_due']) %}
    <p>Freigeschaltet durch das Team bis {{ user.compAccessUntil | date }}.</p>
  {% elif sub and sub.status in ['active', 'trialing', 'past_due'] %}
    <dl class="summary">
      <div><dt>Status</dt><dd>{% if sub.cancel_at_period_end %}gekündigt, aktiv bis {{ sub.current_period_end | date }}{% elif sub.status == 'past_due' %}Zahlung offen, bitte Zahlungsmittel prüfen{% else %}aktiv{% endif %}</dd></div>
      {% if sub.current_period_end and not sub.cancel_at_period_end %}<div><dt>Nächste Verlängerung</dt><dd>{{ sub.current_period_end | date }}</dd></div>{% endif %}
      <div><dt>Mitglied seit</dt><dd>{{ sub.started_at | date }}</dd></div>
      <div><dt>Monatlich</dt><dd>{{ priceLabel }} €{% if sub.telegram_addon %} + {{ telegramPriceLabel }} € Telegram-Kreis{% endif %}</dd></div>
    </dl>
    <div class="actions">
      {% if sub.cancel_at_period_end %}
        <form method="post" action="/app/konto/abo/fortsetzen" class="inline-form">{{ csrf() }}<button class="btn" type="submit">Abo fortsetzen</button></form>
      {% else %}
        <form method="post" action="/app/konto/abo/kuendigen" class="inline-form" data-confirm="Willst du dein Abo wirklich zum Ende des Zeitraums kündigen?">{{ csrf() }}<button class="btn btn-ghost" type="submit">Abo kündigen</button></form>
      {% endif %}
      {% if sub.telegram_addon %}
        <form method="post" action="/app/konto/telegram/beenden" class="inline-form" data-confirm="Telegram-Kreis wirklich beenden? Du verlierst den Zugang zu Gruppe und Kanal sofort.">{{ csrf() }}<button class="btn btn-ghost" type="submit">Telegram-Kreis beenden</button></form>
      {% elif telegramAddon %}
        <a class="btn btn-ghost" href="/app/community">Telegram-Kreis dazubuchen</a>
      {% endif %}
      {% if sub.provider == 'stripe' %}
        <form method="post" action="/app/konto/abo/verwalten" class="inline-form">{{ csrf() }}<button class="btn btn-ghost" type="submit">Zahlungsmittel &amp; Rechnungen</button></form>
      {% endif %}
    </div>
  {% else %}
    <p>Du hast gerade keine aktive Mitgliedschaft.</p>
    <a class="btn" href="/app/freischalten">Mitgliedschaft ansehen</a>
  {% endif %}
</section>

<div class="dash-grid">
  <section class="panel cut">
    <h2 class="h3">Profil</h2>
    <form method="post" action="/app/konto/name" class="stack">
      {{ csrf() }}
      <label>Vorname<input name="first_name" value="{{ user.firstName }}" required minlength="2" maxlength="60"></label>
      <label>E-Mail<input value="{{ user.email }}" disabled></label>
      <button class="btn btn-small" type="submit">Speichern</button>
    </form>
  </section>
  <section class="panel cut">
    <h2 class="h3">Passwort ändern</h2>
    {{ showErrors(pwErrors) }}
    <form method="post" action="/app/konto/passwort" class="stack">
      {{ csrf() }}
      <label>Aktuelles Passwort<input type="password" name="current" required autocomplete="current-password" maxlength="200"></label>
      <label>Neues Passwort<input type="password" name="password" required minlength="10" maxlength="200" autocomplete="new-password"></label>
      <label>Neues Passwort wiederholen<input type="password" name="password2" required minlength="10" maxlength="200" autocomplete="new-password"></label>
      <button class="btn btn-small" type="submit">Passwort ändern</button>
    </form>
  </section>
</div>

<section class="panel cut" id="sicherheit">
  <h2 class="h3">Sicherheit</h2>
  {% if totpError %}<p class="notice notice-warn">{{ totpError }}</p>{% endif %}
  {% if totpSetup %}
    <p><strong>Zwei-Faktor-Anmeldung einrichten:</strong> Scanne den Code mit einer Authenticator-App (z. B. Aegis, 2FAS, Google Authenticator) und gib danach den angezeigten Code ein.</p>
    <div class="totp">
      <img src="{{ totpSetup.qrDataUri }}" alt="QR-Code für die Authenticator-App" width="180" height="180">
      <div>
        <p class="small muted">Oder manuell eingeben:</p>
        <code class="secret">{{ totpSetup.secret }}</code>
        <form method="post" action="/app/konto/2fa/bestaetigen" class="stack">
          {{ csrf() }}
          <label>Code aus der App<input name="code" inputmode="numeric" maxlength="7" autocomplete="one-time-code" required></label>
          <button class="btn btn-small" type="submit">Aktivieren</button>
        </form>
      </div>
    </div>
  {% elif user.totpEnabled %}
    <p>Die Zwei-Faktor-Anmeldung ist <strong>aktiv</strong>.</p>
    <details>
      <summary>Ausschalten</summary>
      <form method="post" action="/app/konto/2fa/aus" class="stack">
        {{ csrf() }}
        <label>Passwort<input type="password" name="password" required autocomplete="current-password" maxlength="200"></label>
        <label>Aktueller Code<input name="code" inputmode="numeric" maxlength="7" required></label>
        <button class="btn btn-ghost btn-small" type="submit">Zwei-Faktor-Anmeldung ausschalten</button>
      </form>
    </details>
  {% else %}
    <p>Schütze dein Konto zusätzlich mit einem Code vom Handy.{% if user.isAdmin %} <strong>Für den Adminbereich ist das Pflicht.</strong>{% endif %}</p>
    <form method="post" action="/app/konto/2fa/start">{{ csrf() }}<button class="btn btn-small" type="submit">Zwei-Faktor-Anmeldung einrichten</button></form>
  {% endif %}

  <h3 class="h4">Angemeldete Geräte</h3>
  <p class="small muted">Dein Konto kann auf höchstens {{ maxDevices }} Geräten gleichzeitig angemeldet sein. Meldest du dich auf einem weiteren an, wird das älteste abgemeldet. Bei einem neuen Gerät bekommst du eine E-Mail.</p>
  <ul class="sessions">
    {% for s in sessionsList %}
    <li><span>{{ s.user_agent | truncate(70) or 'Unbekanntes Gerät' }}</span> <span class="small muted">zuletzt {{ s.last_seen_at | date(true) }}{% if s.current %} · dieses Gerät{% endif %}</span></li>
    {% endfor %}
  </ul>
  {% if sessionsList.length > 1 %}
  <form method="post" action="/app/konto/sitzungen-beenden">{{ csrf() }}<button class="btn btn-ghost btn-small" type="submit">Alle anderen Geräte abmelden</button></form>
  {% endif %}
</section>

<section class="panel cut">
  <h2 class="h3">Deine Daten</h2>
  <p>Du kannst alle Daten, die wir über dich gespeichert haben, als Datei herunterladen.</p>
  <p><a class="btn btn-ghost btn-small" href="/app/konto/daten">Meine Daten herunterladen</a></p>
  <details class="danger">
    <summary>Konto löschen</summary>
    {% if deleteError %}<p class="notice notice-warn">{{ deleteError }}</p>{% endif %}
    <p>Dein Abo wird sofort beendet, alle Lerndaten werden gelöscht. Das lässt sich nicht rückgängig machen.</p>
    <form method="post" action="/app/konto/loeschen" class="stack">
      {{ csrf() }}
      <label>Passwort<input type="password" name="password" required autocomplete="current-password" maxlength="200"></label>
      <label>Tippe LÖSCHEN zur Bestätigung<input name="confirm" required maxlength="20" autocomplete="off"></label>
      <button class="btn btn-danger btn-small" type="submit">Konto endgültig löschen</button>
    </form>
  </details>
</section>
{% endblock %}

