{% extends "layout/app.njk" %}
{% from "partials/macros.njk" import csrf with context %}
{% block app %}
<header class="app-head">
  <h1 class="h1">Community</h1>
  <p class="muted">Kanal der Lehrer und Gruppe mit Themenbereichen, beides auf Telegram.</p>
</header>
<section class="panel cut">
  {% if not enabled %}
    <h2 class="h3">Die Community startet in Kürze.</h2>
    <p>Sobald der Telegram-Zugang eingerichtet ist, bekommst du hier deinen persönlichen Einladungslink.</p>
  {% elif links and links.length %}
    <h2 class="h3">Deine persönlichen Einladungen</h2>
    <p>Jeder Link funktioniert genau einmal und ist eine Stunde gültig. Bitte nicht weitergeben.</p>
    <p class="actions">{% for l in links %}<a class="btn" href="{{ l.url }}" rel="noopener noreferrer" target="_blank">{{ l.label }} öffnen</a> {% endfor %}</p>
  {% else %}
    {% if error %}<p class="notice notice-warn">{{ error }}</p>{% endif %}
    <h2 class="h3">Beitreten</h2>
    <p>Erstelle deinen persönlichen Einladungslink. Dein Zugang ist an deine Mitgliedschaft gekoppelt.</p>
    <form method="post" action="/app/community/einladung">{{ csrf() }}<button class="btn" type="submit">Einladung erstellen</button></form>
  {% endif %}
</section>
<section class="cards cards-2">
  <article class="card cut"><p class="eyebrow">Montag</p><h2 class="h4">Wochenziel posten</h2><p>Ein Satz reicht: Was erledigst du diese Woche?</p></article>
  <article class="card cut"><p class="eyebrow">Freitag</p><h2 class="h4">Ergebnis teilen</h2><p>Geschafft oder nicht: ehrlich berichten, daraus lernen.</p></article>
</section>
{% endblock %}
