{% extends "layout/base.njk" %}
{% block main %}
<section class="section">
  <div class="wrap narrow prose">
    <p class="eyebrow">Rechtliches</p>
    <h1 class="h1">{{ title }}</h1>
    <p class="notice notice-warn">Entwurf. Platzhalter in eckigen Klammern müssen vor dem Start ergänzt und der gesamte Text rechtlich geprüft werden.</p>
    {% block legal %}{% endblock %}
  </div>
</section>
{% endblock %}
