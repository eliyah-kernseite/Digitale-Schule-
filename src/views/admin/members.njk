{% extends "layout/app.njk" %}
{% block app %}
<header class="app-head"><h1 class="h1">Mitglieder</h1></header>
<form method="get" class="filter"><label>Suche<input name="q" value="{{ q }}" maxlength="100" placeholder="Name oder E-Mail"></label><button class="btn btn-small" type="submit">Suchen</button></form>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Name</th><th>E-Mail</th><th>Abo</th><th>Seminare</th><th>Seit</th></tr></thead>
  <tbody>
  {% for r in rows %}
    <tr>
      <td><a href="/admin/mitglieder/{{ r.id }}">{{ r.first_name }}</a>{% if r.role == 'admin' %} <span class="chip">Admin</span>{% endif %}{% if r.disabled_at %} <span class="chip">gesperrt</span>{% endif %}</td>
      <td>{{ r.email }}{% if not r.email_verified_at %} <span class="small muted">(unbestätigt)</span>{% endif %}</td>
      <td>{{ r.status or '–' }}{% if r.cancel_at_period_end %} (gekündigt){% endif %}</td>
      <td>{{ r.done }}</td>
      <td>{{ r.created_at | date }}</td>
    </tr>
  {% else %}<tr><td colspan="5" class="muted">Keine Treffer.</td></tr>{% endfor %}
  </tbody>
</table>
</div>
{% endblock %}
