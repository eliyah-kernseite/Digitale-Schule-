{% extends "layout/app.njk" %}
{% block app %}
<header class="app-head"><h1 class="h1">Protokoll</h1><p class="muted">Sicherheitsrelevante Aktionen, neueste zuerst.</p></header>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Wann</th><th>Wer</th><th>Aktion</th><th>Details</th></tr></thead>
  <tbody>
  {% for r in rows %}<tr><td>{{ r.created_at | date(true) }}</td><td>{{ r.email or '–' }}</td><td>{{ r.action }}</td><td>{{ r.detail }}</td></tr>{% endfor %}
  </tbody>
</table>
</div>
{% endblock %}
