{% extends "layout/app.njk" %}
{% block app %}
<header class="app-head"><h1 class="h1">Aufgaben</h1></header>
<form method="get" class="filter">
  <label>Seminar
    <select name="seminar"><option value="">alle</option>{% for s in seminars %}<option value="{{ s.id }}" {% if s.id == seminarId %}selected{% endif %}>{{ s.position }} · {{ s.title }}</option>{% endfor %}</select>
  </label>
  <button class="btn btn-small" type="submit">Filtern</button>
</form>
{% for r in rows %}
<article class="panel cut submission">
  <p class="small muted">{{ r.submitted_at | date(true) }} · <a href="/admin/mitglieder/{{ r.user_id }}">{{ r.first_name }}</a> · Seminar {{ r.position }}: {{ r.title }}</p>
  <blockquote>{{ r.content }}</blockquote>
</article>
{% else %}
<p class="muted">Keine Abgaben.</p>
{% endfor %}
{% endblock %}
