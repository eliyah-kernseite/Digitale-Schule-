{# Beispiel-Zeugnis. Muss als Beispiel gekennzeichnet bleiben. #}
{% set rows = [['Klarheit', 4, 8], ['Selbstvertrauen', 3, 7], ['Disziplin', 5, 8], ['Innere Ruhe', 4, 7], ['Zielfortschritt', 2, 6]] %}
<div class="report-card cut">
  <p class="eyebrow">Dein Zeugnis · Beispiel</p>
  <h3 class="h3">Fortschritt, den du siehst.</h3>
  <ul class="report-bars">
    {% for r in rows %}
    <li>
      <span class="report-label">{{ r[0] }}</span>
      <svg viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true">
          <rect x="0" y="1" width="100" height="12" class="trk"/>
        <rect x="0" y="1" width="{{ r[1] * 10 }}" height="5" class="w0"/>
        <rect x="0" y="8" width="{{ r[2] * 10 }}" height="5" class="w12"/>
      </svg>
      <span class="report-vals">{{ r[1] }} → {{ r[2] }}</span>
    </li>
    {% endfor %}
  </ul>
  <p class="small muted"><span class="key key-w0"></span> Woche 0 &nbsp; <span class="key key-w12"></span> Woche 12 &nbsp;·&nbsp; Beispielwerte, kein Ergebnisversprechen.</p>
</div>
