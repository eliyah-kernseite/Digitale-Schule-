<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ schoolName }}</title>
  <meta name="description" content="{{ metaDescription or 'Die digitale Schule für Männer. Persönlichkeit, Geld und Fitness. Echter Unterricht, messbarer Fortschritt.' }}">
  <meta name="theme-color" content="#16130f">
  <link rel="preload" href="/fonts/fundament-display.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/main.css?v={{ assetVersion }}">
  <link rel="icon" href="/img/icon.svg" type="image/svg+xml">
  {% block head %}{% endblock %}
</head>
<body class="{% block bodyClass %}{% endblock %}">
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  {% block header %}
  <header class="site-header">
    <div class="wrap header-row">
      <a class="logo" href="/" aria-label="{{ schoolName }} Startseite">{% include "partials/logo.njk" %}</a>
      <button class="nav-btn" type="button" aria-expanded="false" aria-controls="hauptmenue" aria-label="Menü"><span></span><span></span><span></span></button>
        <nav class="site-nav" id="hauptmenue" aria-label="Hauptmenü">
          <a href="/faecher" {% if path.startsWith('/faecher') %}aria-current="page"{% endif %}>Fächer</a>
          <a href="/so-funktionierts" {% if path == '/so-funktionierts' %}aria-current="page"{% endif %}>So funktioniert’s</a>
          <a href="/lehrplan" {% if path == '/lehrplan' %}aria-current="page"{% endif %}>Lehrplan</a>
          <a href="/community" {% if path == '/community' %}aria-current="page"{% endif %}>Community</a>
          <a href="/beitraege" {% if path.startsWith('/beitraege') %}aria-current="page"{% endif %}>Beiträge</a>
          {% if user %}
            <a class="btn btn-small" href="/app">Mein Bereich</a>
          {% else %}
            <a class="nav-login" href="/login">Login</a>
            <a class="btn btn-small" href="/mitgliedschaft">Mitglied werden</a>
          {% endif %}
        </nav>
    </div>
  </header>
  {% endblock %}

  {% block notice %}{% if notice %}
  <div class="wrap"><p class="notice notice-{{ notice.kind }}" role="status">{{ notice.text }}</p></div>
  {% endif %}{% endblock %}

  <main id="inhalt">
    {% block main %}{% endblock %}
  </main>

  {% block footer %}
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <a class="logo logo-footer" href="/">{% include "partials/logo.njk" %}</a>
        <p class="muted small">Die digitale Schule für Männer. Fortschritt statt Versprechen.</p>
      </div>
      <nav aria-label="Rechtliches" class="footer-links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/agb">AGB</a>
        <a href="/widerruf">Widerruf</a>
        <a class="footer-cancel" href="/kuendigen">Verträge hier kündigen</a>
      </nav>
    </div>
    <div class="wrap small muted footer-note">Nur technisch notwendige Cookies. Kein Tracking, keine Werbung.</div>
  </footer>
  {% endblock %}
  <script src="/js/site.js?v={{ assetVersion }}" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
